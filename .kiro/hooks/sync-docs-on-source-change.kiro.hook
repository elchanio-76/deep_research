{
  "enabled": true,
  "name": "Sync Docs on Source Change",
  "description": "When any Python source file, requirements.txt, or config files change, ask the agent to update the README or docs folder to reflect the changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.py",
      "requirements.txt",
      ".env.example",
      "*.cfg",
      "*.toml",
      "*.ini"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the change and determine if any documentation needs to be updated. If the change affects usage, configuration, setup, API behavior, or module responsibilities, update the README.md accordingly. If a /docs folder exists, update the relevant files there instead. Keep changes minimal and accurate — only update what's actually affected by the source change."
  }
}